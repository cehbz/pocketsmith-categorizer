<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cehbz.pocketsmith-categorizer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/categorize</string>
    <string>run</string>
    <string>-notify</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/pocketsmith-categorizer/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/pocketsmith-categorizer/agent.log</string>
</dict>
</plist>
